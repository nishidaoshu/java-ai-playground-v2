{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","additionalProperties":false,
 "required":["id","version","description","scenarios","agent","inputRequirements","resultFormat","allowedTools","maxSteps","maxToolCalls","requiredEvidence","failureRules"],
 "properties":{
  "id":{"enum":["terms_qa","order_lookup","change_plan"]},
  "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "description":{"type":"string","minLength":5,"maxLength":300},
  "scenarios":{"type":"array","minItems":1,"items":{"type":"string","minLength":2}},
  "agent":{"enum":["knowledge","order"]},
  "inputRequirements":{"type":"array","minItems":1,"items":{"type":"string"}},
  "resultFormat":{"enum":["grounded_answer","owned_orders","pending_plan"]},
  "allowedTools":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["search_knowledge","get_my_orders","get_order","propose_cancellation","propose_change"]}},
  "maxSteps":{"type":"integer","minimum":1,"maximum":4},
  "maxToolCalls":{"type":"integer","minimum":1,"maximum":8},
  "requiredEvidence":{"type":"array","minItems":1,"items":{"type":"string"}},
  "failureRules":{"type":"array","minItems":1,"items":{"type":"string"}}
 }
}
