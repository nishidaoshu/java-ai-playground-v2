# Copy only into the external .java-ai-runtime-v2/local.env; no DeepSeek key here.
DB_PORT=15433
DB_BIND_ADDRESS=0.0.0.0
DB_USER=java_ai_v2
DB_PASSWORD=replace-with-random-local-password
APP_PORT=8082
EMBEDDING_PORT=18083
MCP_PORT=18084
DEEPSEEK_MODEL=deepseek-flash
RERANK_MODEL=deepseek-flash
APP_RAG_CHUNK_SIZE=420
APP_RAG_OVERLAP=80
APP_RAG_CANDIDATES=8
APP_RAG_TOP_K=4
APP_RAG_MIN_SIMILARITY=0.50
APP_RAG_RETRY_MIN_SIMILARITY=0.40
APP_RAG_RERANK_THRESHOLD=0.60
APP_WORKFLOW_TTL_SECONDS=300
V2_MAX_DELEGATIONS=2
V2_MAX_TOOLS=8
V2_MAX_RETRIEVALS=2
V2_MAX_MODELS=12
V2_MAX_SECONDS=240
# MCP_SERVICE_TOKEN and MCP_SIGNING_KEY are decrypted from mcp-secrets.dpapi, not this file.
